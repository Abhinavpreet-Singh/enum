# ─── Database (PostgreSQL on Dokploy) ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/enum

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh
JWT_SECRET=change-me-jwt

# ─── OAuth (optional) ───────────────────────────────────────────────────────
# Callbacks must match Google Cloud / GitHub App settings CHARACTER-FOR-CHARACTER.
# Production:
#   GOOGLE_CALLBACK_URL=https://api.enum.live/auth/google/callback
#   GITHUB_CALLBACK_URL=https://api.enum.live/auth/github/callback
# If CALLBACK_URL is omitted, it is derived from BACKEND_URL + /auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# ─── Cookies (production / cross-site) ──────────────────────────────────────
# COOKIE_CROSS_SITE=true
# COOKIE_DOMAIN=.enum.live

# ─── Redis (complexity cache / job queue) ───────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@enum.live

# ─── Payments (Razorpay) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Compiler runtime ─────────────────────────────────────────────────────────
# COMPILER_RUNTIME=local
