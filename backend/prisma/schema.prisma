generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

type UserLinks {
  github  String @default("")
  linkedin String @default("")
  website String @default("")
}

type UserCert {
  name   String
  issuer String
  date   String
  done   Boolean @default(false)
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  email        String   @unique
  password     String?
  refreshToken String?
  displayName  String?
  bio          String   @default("")
  college      String   @default("")
  role         String   @default("Student")
  accountRole  String   @default("student") // "student" | "recruiter" | "admin"
  location     String   @default("")
  resume       String   @default("")
  skills       String[] @default([])
  links        UserLinks?
  certs        UserCert[]
  avatar           String    @default("")
  provider         String?
  xp               Int       @default(0)
  browserXpClaims       String[]  @default([])
  systemDesignXpClaims  String[]  @default([])
  incidentXpClaims      String[]  @default([])
  questionXpClaims      String[]  @default([])
  simulationXpClaims    String[]  @default([])
  currentStreak    Int       @default(0)
  lastActivityDate DateTime?
  solutions              Solution[]
  submissions            Submission[]
  simulationProgress     UserSimulationProgress[]
  systemDesignSubmissions SystemDesignSubmission[]
  incidentSessions       IncidentSession[]
  activityLogs           UserActivityLog[]
  xpAwards               UserXpAward[]
  candidateAttempts      CandidateAttempt[]

  @@map("users")
}

/// One row per resource — prevents duplicate XP even if claim arrays fail to persist
model UserXpAward {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  awardKey  String
  xpAmount  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, awardKey])
  @@map("userxpawards")
}

// ─── User activity log (all submission types) ────────────────────────────────

model UserActivityLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  activityType  String   /// dsa | simulation | system_design | incident | browser
  resourceId    String   @db.ObjectId
  resourceTitle String   @default("")
  outcome       String   /// correct | partial | incorrect
  xpEarned      Int      @default(0)
  score         Int?
  maxScore      Int?
  detail        String   @default("")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("useractivitylogs")
}

// ─── OTP Verification ────────────────────────────────────────────────────────

model OtpVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime

  @@map("otp_verifications")
}

// ─── Company ─────────────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  password       String
  refreshToken   String?
  website        String   @default("")
  industry       String   @default("")
  size           String   @default("")   // "1-10" | "11-50" | "51-200" | "200+"
  location       String   @default("")
  description    String   @default("")
  logo           String   @default("")
  approvalStatus String   @default("approved") // "pending" | "approved" | "rejected"
  contactName    String   @default("")
  contactEmail   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessments    Assessment[]
  questionBanks  QuestionBank[]

  @@map("companies")
}

model CompanyOtpVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime

  @@map("company_otp_verifications")
}

// ─── College ─────────────────────────────────────────────────────────────────

model College {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String   @unique
  password         String
  refreshToken     String?
  website          String   @default("")
  coordinatorName  String   @default("")
  coordinatorEmail String   @default("")
  approvalStatus   String   @default("pending") // "pending" | "approved" | "rejected"
  logo             String   @default("")
  location         String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("colleges")
}

model CollegeOtpVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime

  @@map("college_otp_verifications")
}

// ─── Assessment Platform ─────────────────────────────────────────────────────

model Assessment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String    @db.ObjectId
  title          String
  description    String    @default("")
  duration       Int       @default(60) // minutes
  startDate      DateTime?
  endDate        DateTime?
  maxAttempts    Int       @default(1)
  passingScore   Int       @default(60) // percentage
  status         String    @default("draft") // "draft" | "published" | "archived"
  accessType     String    @default("public") // "public" | "invite_only" | "password"
  accessPassword String?
  testCode       String    @unique
  totalQuestions Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company   @relation(fields: [companyId], references: [id])
  settings       AssessmentSetting?
  questions      AssessmentQuestion[]
  invites        AssessmentInvite[]
  attempts       CandidateAttempt[]

  @@index([companyId])
  @@map("assessments")
}

model AssessmentSetting {
  id                    String  @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId          String  @unique @db.ObjectId
  // Device restrictions
  lockScreen            Boolean @default(false)
  disableAltTab         Boolean @default(false)
  disableWinKey         Boolean @default(false)
  disableTaskSwitch     Boolean @default(false)
  disableMultiMonitor   Boolean @default(false)
  forceFullscreen       Boolean @default(false)
  requireDesktopApp     Boolean @default(false)
  // Screen monitoring
  requireScreenShare    Boolean @default(false)
  recordScreen          Boolean @default(false)
  periodicScreenshots   Boolean @default(false)
  liveMonitoring        Boolean @default(false)
  // Webcam
  requireWebcam         Boolean @default(false)
  recordWebcam          Boolean @default(false)
  faceDetection         Boolean @default(false)
  multipleFaceDetection Boolean @default(false)
  phoneDetection        Boolean @default(false)
  eyeTracking           Boolean @default(false)
  // Audio
  requireMicrophone     Boolean @default(false)
  recordAudio           Boolean @default(false)
  voiceDetection        Boolean @default(false)
  // Anti-cheating
  copyPasteDetection    Boolean @default(true)
  typingPatternAnalysis Boolean @default(false)
  aiDetection           Boolean @default(false)
  devToolsDetection     Boolean @default(true)
  vmDetection           Boolean @default(false)
  remoteDesktopDetection Boolean @default(false)
  // Network
  allowInternet         Boolean @default(false)
  allowExternalSites    Boolean @default(false)
  whitelistDomains      String[] @default([])

  assessment            Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessmentsettings")
}

model QuestionBank {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  name        String
  category    String   // "mcq" | "coding" | "sql" | "linux" | "frontend" | "backend" | "devops" | "system_design" | "incident"
  description String   @default("")
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  questions   BankQuestion[]

  @@index([companyId])
  @@map("questionbanks")
}

model BankQuestion {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  bankId         String   @db.ObjectId
  type           String   // "mcq" | "msq" | "numerical" | "coding" | "sql" | "linux"
  title          String
  description    String   @default("")
  difficulty     String   @default("medium") // "easy" | "medium" | "hard"
  options        Json?    // for MCQ/MSQ: [{ text, isCorrect }]
  correctAnswer  Json?    // answer data
  codeTemplate   String?  // for coding questions
  testCases      Json[]   @default([])
  points         Int      @default(10)
  tags           String[] @default([])
  technology     String   @default("")
  topic          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bank           QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
  @@map("bankquestions")
}

model AssessmentQuestion {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId   String  @db.ObjectId
  questionType   String  // "bank" | "simulation" | "system_design" | "incident"
  bankQuestionId String? @db.ObjectId
  simulationId   String? @db.ObjectId
  order          Int     @default(0)
  points         Int     @default(10)
  required       Boolean @default(true)

  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessmentquestions")
}

model AssessmentInvite {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId String   @db.ObjectId
  email        String
  rollNumber   String?
  status       String   @default("pending") // "pending" | "accepted" | "completed"
  sentAt       DateTime @default(now())

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessmentinvites")
}

model CandidateAttempt {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId    String    @db.ObjectId
  userId          String?   @db.ObjectId
  email           String
  rollNumber      String?
  status          String    @default("in_progress") // "in_progress" | "submitted" | "auto_submitted" | "flagged"
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  totalScore      Int       @default(0)
  maxScore        Int       @default(0)
  answers         Json[]    @default([])
  codeSubmissions Json[]    @default([])
  suspicionLevel  String    @default("low") // "low" | "medium" | "high"

  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  user            User?      @relation(fields: [userId], references: [id])
  violations      Violation[]

  @@index([assessmentId])
  @@index([userId])
  @@map("candidateattempts")
}

model Violation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  attemptId   String   @db.ObjectId
  type        String   // "tab_switch" | "fullscreen_exit" | "copy_paste" | "multi_face" | "devtools" | "disconnect"
  description String   @default("")
  timestamp   DateTime @default(now())
  severity    String   @default("low") // "low" | "medium" | "high"
  metadata    Json?

  attempt     CandidateAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("violations")
}

// ─── Question ────────────────────────────────────────────────────────────────

model Question {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String?
  desc           String?
  level          String   @default("Easy") // "Easy" | "Medium" | "Hard"
  testcases      Json[]
  constraints    String?
  topic          String?
  functionName   String
  parameterNames String[] @default([])
  parameterTypes String[]
  returnType     String
  initialCode    Json[]   @default([])

  solutions      Solution[]
  submissions    Submission[]
  editorials     Editorial[]

  @@map("questions")
}

// ─── Linux Question ────────────────────────────────────────────────────────

model LinuxQuestion {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  slug           String   @unique
  title          String
  description    String
  difficulty     String   @default("easy")
  examples       Json[]   @default([])
  starterCode    String   @default("#!/usr/bin/env bash\n# Write your command here")
  expectedOutput String   @default("")
  constraints    String[] @default([])
  hints          String[] @default([])
  language       String   @default("bash")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("linuxquestions")
}

// ─── Solution ────────────────────────────────────────────────────────────────

model Solution {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId String   @db.ObjectId
  userId     String   @db.ObjectId
  code       String
  language   String   @default("javascript")
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("solutions")
}

// ─── Submission ──────────────────────────────────────────────────────────────

model Submission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId  String   @db.ObjectId
  userId      String   @db.ObjectId
  code        String
  language    String   @default("python")
  verdict     String   @default("wrong_answer") // accepted | wrong_answer | runtime_error | compile_error | error | partial
  passedCount Int      @default(0)
  totalCount  Int      @default(0)
  runtime     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("submissions")
}

// ─── Editorial ───────────────────────────────────────────────────────────────

model Editorial {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId      String   @unique @db.ObjectId
  title           String
  intuition       String?
  approach        String?
  algorithm       String?
  code            String?
  timeComplexity  String?
  spaceComplexity String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])

  @@map("editorials")
}

// ─── Simulation ──────────────────────────────────────────────────────────────

type SimulationFile {
  name              String @default("")
  path              String @default("")
  content           String @default("")
  language          String @default("javascript")
  cloudinaryUrl     String @default("")
  cloudinaryPublicId String @default("")
}

type SimulationStep {
  description String @default("")
}

model Simulation {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  category       String           // "frontend" | "backend" | "fullstack" | "devops"
  difficulty     String           @default("easy") // "easy" | "medium" | "hard"
  description    String
  incident       String
  steps          SimulationStep[]
  initialFiles   SimulationFile[]
  solution       Json             @default("{}")
  hints          String[]         @default([])
  estimatedTime  Int              @default(15)
  tags           String[]         @default([])
  xpReward       Int              @default(50)
  entryFile      String           @default("index.js")
  expectedOutput String           @default("")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  progress UserSimulationProgress[]

  @@map("simulations")
}

// ─── UserSimulationProgress ──────────────────────────────────────────────────

model UserSimulationProgress {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  simulationId  String    @db.ObjectId
  solved        Boolean   @default(false)
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  modifiedFiles Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  simulation Simulation @relation(fields: [simulationId], references: [id])

  @@unique([userId, simulationId])
  @@map("usersimulationprogresses")
}

// ─── System Design ───────────────────────────────────────────────────────────

type EvaluationRule {
  description String
  /// Component type that must exist (e.g. "load_balancer")
  requiredComponent String  @default("")
  /// "source→target" component id pair (e.g. "client→load_balancer")
  requiredEdge      String  @default("")
  points            Int     @default(1)
}

model SystemDesignSimulation {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  difficulty      String           @default("medium")
  evaluationRules EvaluationRule[]
  maxScore        Int              @default(10)
  tags            String[]         @default([])
  templateUrl     String           @default("")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  submissions SystemDesignSubmission[]

  @@map("systemdesignsimulations")
}

type SDFeedbackItem {
  rule    String
  passed  Boolean
  message String
}

model SystemDesignSubmission {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  simulationId  String         @db.ObjectId
  userId        String         @db.ObjectId
  nodes         Json
  edges         Json
  explanation   String         @default("")
  replayEvents  Json?
  score         Int            @default(0)
  maxScore      Int            @default(0)
  feedback      SDFeedbackItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  simulation SystemDesignSimulation @relation(fields: [simulationId], references: [id])
  user       User                   @relation(fields: [userId], references: [id])

  @@map("systemdesignsubmissions")
}

// ─── Historical Incident Simulations ─────────────────────────────────────────

/// Represents a service in the incident topology
type IncidentService {
  id        String  @default("") /// Unique service ID (e.g., "frontend", "api")
  name      String  @default("") /// Display name
  status    String  @default("healthy") /// "healthy" | "degraded" | "critical" | "down"
  color     String  @default("green") /// Visual indicator color
}

/// Represents a root cause option for diagnosis
type IncidentRootCauseOption {
  id          String  @default("") /// Unique ID for this option
  title       String  @default("") /// e.g., "Regex backtracking in regex engine"
  description String  @default("") /// Detailed explanation
  isCorrect   Boolean @default(false) /// Is this the right answer?
  hint        String  @default("") /// Hint for the user
}

/// Represents an action the user can take to fix the incident
type IncidentActionOption {
  id              String  @default("") /// Unique action ID (e.g., "rollback", "restart", "scale_up")
  title           String  @default("") /// e.g., "Rollback deployment"
  description     String  @default("") /// What does this action do?
  category        String  @default("") /// "rollback" | "restart" | "scale" | "investigate"
  fixesMetrics    String[] @default([]) /// Which metrics does this fix? ["cpu_usage", "error_rate"]
  recoveryTime    Int     @default(30) /// Seconds until metrics improve
  pointsIfCorrect Int     @default(50) /// Points awarded if user took this action
  pointsIfWrong   Int     @default(0) /// Penalty if this doesn't help
}

/// Represents a metric value at a specific point in time
type IncidentMetricSnapshot {
  timestamp Int     @default(0) /// Time in seconds since simulation start
  value     Float   @default(0) /// Metric value (percentage, ms, requests/sec, etc.)
}

/// Represents an event that happens at a specific time in the timeline
model IncidentTimelineEvent {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId        String   @db.ObjectId /// Reference to IncidentSimulation
  timeSecond        Int      @default(0) /// When event triggers (in seconds)
  title             String   @default("") /// Event title
  description       String   @default("") /// Event description
  affectedServices  String[] @default([]) /// Which services are affected (by ID)
  metricChanges     Json     @default("{}") /// { metricName: newValue }
  logMessage        String   @default("") /// Log entry to add
  priority          String   @default("info") /// "info" | "warning" | "critical"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  incident IncidentSimulation @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("incidenttimelineevents")
}

/// Main incident simulation model
model IncidentSimulation {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  title            String                /// e.g., "Regex Catastrophe"
  description      String                /// Brief incident description
  difficulty       String                @default("medium") /// "easy" | "medium" | "hard"
  category         String                @default("incident") /// Always "incident" for this model
  simulationType   String                @default("production") /// Type of incident
  durationSeconds  Int                   @default(300) /// Total simulation duration
  estimatedTime    Int                   @default(15) /// In minutes
  xpReward         Int                   @default(100)
  tags             String[]              @default([])

  /// Initial state
  initialServices  IncidentService[]     /// Services at simulation start
  initialMetrics   Json                  @default("{}") /// { metricName: [IncidentMetricSnapshot] }
  initialLogs      String[]              @default([]) /// Starting log entries

  /// Real incident inspiration
  realIncidentName String                @default("") /// e.g., "Cloudflare 2019 Regex Outage"
  realIncidentDate String                @default("") /// e.g., "July 2, 2019"
  realIncidentLink String                @default("") /// Documentation link
  realIncidentDesc String                @default("") /// What actually happened

  /// Reveal screen (shown after user completes or gives up)
  revealTitle      String                @default("Based on...")
  revealText       String                @default("") /// Full reveal description

  /// Diagnosis (root cause selection)
  rootCauseOptions IncidentRootCauseOption[] /// Multiple choice options
  actionOptions    IncidentActionOption[]    /// Available actions to take

  /// User progress
  sessions         IncidentSession[]
  timelineEvents   IncidentTimelineEvent[]

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("incidentsimulations")
}

/// Represents a user's active session/attempt at an incident
model IncidentSession {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId /// User attempting the incident
  incidentId      String    @db.ObjectId /// Which incident
  elapsedTime     Int       @default(0) /// Seconds elapsed in this session
  isActive        Boolean   @default(true) /// Is session still running
  isCompleted     Boolean   @default(false) /// Did user successfully resolve
  xpAwarded       Boolean   @default(false) /// XP granted once for this incident
  attempts        Int       @default(0) /// Number of completed report submissions
  
  /// Diagnosis phase
  selectedRootCauseId String @default("") /// Which root cause did user select
  diagnosedAt     DateTime? /// When did user make diagnosis
  correctDiagnosis Boolean @default(false) /// Did they get it right?
  
  /// Actions taken
  actionsTaken    Json[]    @default([]) /// [ { actionId, timestamp, effective } ]
  
  /// Scoring
  diagnosticScore Int       @default(0) /// Points for correct diagnosis
  actionScore     Int       @default(0) /// Points for effective actions
  timeBonusScore  Int       @default(0) /// Points for speed
  totalScore      Int       @default(0) /// Final score
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident IncidentSimulation   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  state    IncidentSessionState?

  @@index([userId, incidentId])
  @@map("incidentsessions")
}

/// Current runtime state of an active incident session
model IncidentSessionState {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId    String   @unique @db.ObjectId /// Links to IncidentSession
  currentTime  Int      @default(0) /// Current time in simulation (seconds)
  services     IncidentService[] /// Current service statuses
  metrics      Json     @default("{}") /// { metricName: currentValue }
  logs         String[] @default([]) /// All logs accumulated so far
  activeAlerts String[] @default([]) /// Current alert IDs
  updatedAt    DateTime @updatedAt

  session IncidentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("incidentsessionstates")
}
