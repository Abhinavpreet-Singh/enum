generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  password     String?
  refreshToken String?  // legacy — no longer written; kept until fully removed
  displayName  String?
  bio          String   @default("")
  role         String   @default("Student")
  location     String   @default("")
  resume       String   @default("")
  skills       String[] @default([])
  github       String   @default("")
  linkedin     String   @default("")
  website      String   @default("")
  avatar       String   @default("")
  provider     String?
  xp           Int      @default(0)
  browserXpClaims      String[] @default([])
  systemDesignXpClaims String[] @default([])
  incidentXpClaims     String[] @default([])
  questionXpClaims     String[] @default([])
  simulationXpClaims   String[] @default([])
  currentStreak        Int      @default(0)
  lastActivityDate     DateTime?

  certs                   UserCert[]
  solutions               Solution[]
  submissions             Submission[]
  simulationProgress      UserSimulationProgress[]
  systemDesignSubmissions SystemDesignSubmission[]
  incidentSessions        IncidentSession[]
  activityLogs            UserActivityLog[]
  xpAwards                UserXpAward[]
  candidateAttempts       CandidateAttempt[]
  sessions                Session[]
  entitlements            UserEntitlement[]
  paymentOrders           PaymentOrder[]
  paymentEvents           PaymentEvent[]

  @@map("users")
}

model UserCert {
  id        String   @id @default(cuid())
  userId    String
  name      String
  issuer    String
  date      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_certs")
}

/// One row per resource — prevents duplicate XP even if claim arrays fail to persist
model UserXpAward {
  id        String   @id @default(cuid())
  userId    String
  awardKey  String
  xpAmount  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, awardKey])
  @@map("userxpawards")
}

// ─── User activity log (all submission types) ────────────────────────────────

model UserActivityLog {
  id            String   @id @default(cuid())
  userId        String
  activityType  String   /// dsa | simulation | system_design | incident | browser
  resourceId    String
  resourceTitle String   @default("")
  outcome       String   /// correct | partial | incorrect
  xpEarned      Int      @default(0)
  score         Int?
  maxScore      Int?
  detail        String   @default("")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("useractivitylogs")
}

// ─── OTP Verification ────────────────────────────────────────────────────────

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime

  @@map("otp_verifications")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  accountId   String
  accountType String
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email, accountType])
  @@index([accountType, accountId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Organization ────────────────────────────────────────────────────────────

model Organization {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  refreshToken   String?  // legacy — no longer written; kept until fully removed
  website        String   @default("")
  industry       String   @default("")
  size           String   @default("") // "1-10" | "11-50" | "51-200" | "200+"
  location       String   @default("")
  description    String   @default("")
  logo           String   @default("")
  approvalStatus String   @default("pending") // "pending" | "approved" | "rejected"
  contactName    String   @default("")
  contactEmail   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessments   Assessment[]
  questionBanks QuestionBank[]
  sessions      Session[]

  @@map("organizations")
}

// ─── Auth Sessions (production session store) ─────────────────────────────────

model Session {
  id                   String    @id @default(cuid())
  userId               String?
  organizationId       String?
  accountType          String // "student" | "admin" | "organization"
  refreshTokenHash     String    @unique
  accessTokenHash      String?
  accessTokenExpiresAt DateTime?
  userAgent            String    @default("")
  ipAddress            String    @default("")
  expiresAt            DateTime
  revoked              Boolean   @default(false)
  revokedAt            DateTime?
  lastUsed             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([accessTokenExpiresAt])
  @@map("sessions")
}

model OrganizationOtpVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime

  @@map("organization_otp_verifications")
}

// ─── Assessment Platform ─────────────────────────────────────────────────────

model Assessment {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String    @default("")
  duration       Int       @default(60) // minutes
  startDate      DateTime?
  endDate        DateTime?
  maxAttempts    Int       @default(1)
  passingScore   Int       @default(60) // percentage
  status         String    @default("draft") // "draft" | "published" | "archived"
  accessType     String    @default("public") // "public" | "invite_only" | "password"
  accessPassword String?
  testCode       String    @unique
  totalQuestions Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  settings     AssessmentSetting?
  questions    AssessmentQuestion[]
  invites      AssessmentInvite[]
  attempts     CandidateAttempt[]

  @@index([organizationId])
  @@map("assessments")
}

model AssessmentSetting {
  id                     String   @id @default(cuid())
  assessmentId           String   @unique
  lockScreen             Boolean  @default(false)
  disableAltTab          Boolean  @default(false)
  disableWinKey            Boolean  @default(false)
  disableTaskSwitch      Boolean  @default(false)
  disableMultiMonitor    Boolean  @default(false)
  forceFullscreen        Boolean  @default(false)
  requireDesktopApp      Boolean  @default(false)
  requireScreenShare     Boolean  @default(false)
  recordScreen           Boolean  @default(false)
  periodicScreenshots    Boolean  @default(false)
  liveMonitoring         Boolean  @default(false)
  requireWebcam          Boolean  @default(false)
  recordWebcam           Boolean  @default(false)
  faceDetection          Boolean  @default(false)
  multipleFaceDetection  Boolean  @default(false)
  phoneDetection         Boolean  @default(false)
  eyeTracking            Boolean  @default(false)
  requireMicrophone      Boolean  @default(false)
  recordAudio            Boolean  @default(false)
  voiceDetection         Boolean  @default(false)
  copyPasteDetection     Boolean  @default(true)
  typingPatternAnalysis  Boolean  @default(false)
  aiDetection            Boolean  @default(false)
  devToolsDetection      Boolean  @default(true)
  vmDetection            Boolean  @default(false)
  remoteDesktopDetection Boolean  @default(false)
  allowInternet          Boolean  @default(false)
  allowExternalSites     Boolean  @default(false)
  whitelistDomains       String[] @default([])

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessmentsettings")
}

model QuestionBank {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String // "mcq" | "coding" | "sql" | "linux" | ...
  description    String   @default("")
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  questions    BankQuestion[]

  @@index([organizationId])
  @@map("questionbanks")
}

model BankQuestion {
  id             String   @id @default(cuid())
  bankId         String
  type           String
  title          String
  description    String   @default("")
  difficulty     String   @default("medium")
  correctAnswer  Json?
  codeTemplate   String?
  functionName   String?
  parameterTypes String[] @default([])
  returnType     String?
  points         Int      @default(10)
  tags           String[] @default([])
  technology     String   @default("")
  topic          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bank                QuestionBank           @relation(fields: [bankId], references: [id], onDelete: Cascade)
  options             BankQuestionOption[]
  testCases           BankQuestionTestCase[]
  assessmentQuestions AssessmentQuestion[]

  @@index([bankId])
  @@map("bankquestions")
}

model BankQuestionOption {
  id         String  @id @default(cuid())
  questionId String
  sortOrder  Int     @default(0)
  text       String
  isCorrect  Boolean @default(false)

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("bank_question_options")
}

model BankQuestionTestCase {
  id             String @id @default(cuid())
  questionId     String
  sortOrder      Int    @default(0)
  input          Json?
  expectedOutput String @default("")

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("bank_question_test_cases")
}

model AssessmentQuestion {
  id             String  @id @default(cuid())
  assessmentId   String
  questionType   String // "bank" | "simulation" | "system_design" | "incident"
  bankQuestionId String?
  simulationId   String?
  order          Int     @default(0)
  points         Int     @default(10)
  required       Boolean @default(true)

  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  bankQuestion BankQuestion? @relation(fields: [bankQuestionId], references: [id])
  simulation   Simulation?   @relation(fields: [simulationId], references: [id])

  @@index([assessmentId])
  @@map("assessmentquestions")
}

model AssessmentInvite {
  id           String   @id @default(cuid())
  assessmentId String
  email        String
  rollNumber   String?
  status       String   @default("pending")
  sentAt       DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessmentinvites")
}

model CandidateAttempt {
  id             String    @id @default(cuid())
  assessmentId   String
  userId         String?
  email          String
  rollNumber     String?
  status         String    @default("in_progress")
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  totalScore     Int       @default(0)
  maxScore       Int       @default(0)
  suspicionLevel String    @default("low")

  assessment      Assessment                       @relation(fields: [assessmentId], references: [id])
  user            User?                            @relation(fields: [userId], references: [id])
  answers         CandidateAttemptAnswer[]
  codeSubmissions CandidateAttemptCodeSubmission[]
  violations      Violation[]

  @@index([assessmentId])
  @@index([userId])
  @@map("candidateattempts")
}

model CandidateAttemptAnswer {
  id        String @id @default(cuid())
  attemptId String
  sortOrder Int    @default(0)
  payload   Json

  attempt CandidateAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("candidate_attempt_answers")
}

model CandidateAttemptCodeSubmission {
  id        String @id @default(cuid())
  attemptId String
  sortOrder Int    @default(0)
  payload   Json

  attempt CandidateAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("candidate_attempt_code_submissions")
}

model Violation {
  id          String   @id @default(cuid())
  attemptId   String
  type        String
  description String   @default("")
  timestamp   DateTime @default(now())
  severity    String   @default("low")
  metadata    Json?

  attempt CandidateAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("violations")
}

// ─── Question ────────────────────────────────────────────────────────────────

model Question {
  id             String  @id @default(cuid())
  title          String?
  desc           String?
  level          String  @default("Easy")
  constraints    String?
  topic          String?
  functionName   String
  parameterNames String[] @default([])
  parameterTypes String[]
  returnType     String

  testCases   QuestionTestCase[]
  initialCodes QuestionInitialCode[]
  solutions   Solution[]
  submissions Submission[]
  editorials  Editorial[]

  @@map("questions")
}

model QuestionTestCase {
  id             String @id @default(cuid())
  questionId     String
  sortOrder      Int    @default(0)
  input          Json
  expectedOutput String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_test_cases")
}

model QuestionInitialCode {
  id         String @id @default(cuid())
  questionId String
  language   String
  code       String @default("")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
  @@map("question_initial_codes")
}

// ─── Linux Question ────────────────────────────────────────────────────────

model LinuxQuestion {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String
  difficulty     String   @default("easy")
  starterCode    String   @default("#!/usr/bin/env bash\n# Write your command here")
  expectedOutput String   @default("")
  constraints    String[] @default([])
  hints          String[] @default([])
  language       String   @default("bash")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examples LinuxQuestionExample[]

  @@map("linuxquestions")
}

model LinuxQuestionExample {
  id         String @id @default(cuid())
  questionId String
  sortOrder  Int    @default(0)
  input      String @default("")
  output     String @default("")

  question LinuxQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("linux_question_examples")
}

// ─── Solution ────────────────────────────────────────────────────────────────

model Solution {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  code       String
  language   String   @default("javascript")
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("solutions")
}

// ─── Submission ──────────────────────────────────────────────────────────────

model Submission {
  id          String   @id @default(cuid())
  questionId  String
  userId      String
  code        String
  language    String   @default("python")
  verdict     String   @default("wrong_answer")
  passedCount Int      @default(0)
  totalCount  Int      @default(0)
  runtime     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("submissions")
}

// ─── Editorial ───────────────────────────────────────────────────────────────

model Editorial {
  id              String   @id @default(cuid())
  questionId      String   @unique
  title           String
  intuition       String?
  approach        String?
  algorithm       String?
  code            String?
  timeComplexity  String?
  spaceComplexity String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])

  @@map("editorials")
}

// ─── Simulation ──────────────────────────────────────────────────────────────

model Simulation {
  id             String   @id @default(cuid())
  title          String
  category       String
  difficulty     String   @default("easy")
  description    String
  incident       String
  solution       Json     @default("{}")
  hints          String[] @default([])
  estimatedTime  Int      @default(15)
  tags           String[] @default([])
  xpReward       Int      @default(50)
  entryFile      String   @default("index.js")
  expectedOutput String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps                SimulationStep[]
  initialFiles         SimulationFile[]
  progress             UserSimulationProgress[]
  assessmentQuestions  AssessmentQuestion[]

  @@map("simulations")
}

model SimulationStep {
  id           String @id @default(cuid())
  simulationId String
  sortOrder    Int    @default(0)
  description  String @default("")

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
  @@map("simulation_steps")
}

model SimulationFile {
  id                 String @id @default(cuid())
  simulationId       String
  name               String @default("")
  path               String @default("")
  content            String @default("")
  language           String @default("javascript")
  cloudinaryUrl      String @default("")
  cloudinaryPublicId String @default("")

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
  @@map("simulation_files")
}

model UserSimulationProgress {
  id            String    @id @default(cuid())
  userId        String
  simulationId  String
  solved        Boolean   @default(false)
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  modifiedFiles Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  simulation Simulation @relation(fields: [simulationId], references: [id])

  @@unique([userId, simulationId])
  @@map("usersimulationprogresses")
}

// ─── System Design ───────────────────────────────────────────────────────────

model SystemDesignSimulation {
  id          String   @id @default(cuid())
  title       String
  description String
  difficulty  String   @default("medium")
  maxScore    Int      @default(10)
  tags        String[] @default([])
  templateUrl String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evaluationRules SystemDesignEvaluationRule[]
  submissions     SystemDesignSubmission[]

  @@map("systemdesignsimulations")
}

model SystemDesignEvaluationRule {
  id                String @id @default(cuid())
  simulationId      String
  sortOrder         Int    @default(0)
  description       String
  requiredComponent String @default("")
  requiredEdge      String @default("")
  points            Int    @default(1)

  simulation SystemDesignSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
  @@map("system_design_evaluation_rules")
}

model SystemDesignSubmission {
  id           String   @id @default(cuid())
  simulationId String
  userId       String
  nodes        Json
  edges        Json
  explanation  String   @default("")
  replayEvents Json?
  score        Int      @default(0)
  maxScore     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  simulation    SystemDesignSimulation     @relation(fields: [simulationId], references: [id])
  user          User                       @relation(fields: [userId], references: [id])
  feedbackItems SystemDesignFeedbackItem[]

  @@map("systemdesignsubmissions")
}

model SystemDesignFeedbackItem {
  id           String  @id @default(cuid())
  submissionId String
  sortOrder    Int     @default(0)
  rule         String
  passed       Boolean
  message      String

  submission SystemDesignSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("system_design_feedback_items")
}

// ─── Incident Simulations ────────────────────────────────────────────────────

model IncidentTimelineEvent {
  id               String   @id @default(cuid())
  incidentId       String
  timeSecond       Int      @default(0)
  title            String   @default("")
  description      String   @default("")
  affectedServices String[] @default([])
  metricChanges    Json     @default("{}")
  logMessage       String   @default("")
  priority         String   @default("info")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  incident IncidentSimulation @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incidenttimelineevents")
}

model IncidentSimulation {
  id              String   @id @default(cuid())
  title           String
  description     String
  difficulty      String   @default("medium")
  category        String   @default("incident")
  simulationType  String   @default("production")
  durationSeconds Int      @default(300)
  estimatedTime   Int      @default(15)
  xpReward        Int      @default(100)
  tags            String[] @default([])
  initialLogs     String[] @default([])
  realIncidentName String  @default("")
  realIncidentDate String  @default("")
  realIncidentLink String  @default("")
  realIncidentDesc String  @default("")
  revealTitle      String  @default("Based on...")
  revealText       String  @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  services         IncidentService[]
  rootCauseOptions IncidentRootCauseOption[]
  actionOptions    IncidentActionOption[]
  metricSeries     IncidentMetricSeries[]
  timelineEvents   IncidentTimelineEvent[]
  sessions         IncidentSession[]

  @@map("incidentsimulations")
}

model IncidentService {
  id         String @id @default(cuid())
  incidentId String
  sortOrder  Int    @default(0)
  serviceKey String
  name       String @default("")
  status     String @default("healthy")
  color      String @default("green")

  incident IncidentSimulation @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, serviceKey])
  @@index([incidentId])
  @@map("incident_services")
}

model IncidentRootCauseOption {
  id          String  @id @default(cuid())
  incidentId  String
  sortOrder   Int     @default(0)
  optionKey   String
  title       String  @default("")
  description String  @default("")
  isCorrect   Boolean @default(false)
  hint        String  @default("")

  incident IncidentSimulation @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, optionKey])
  @@index([incidentId])
  @@map("incident_root_cause_options")
}

model IncidentActionOption {
  id              String   @id @default(cuid())
  incidentId      String
  sortOrder       Int      @default(0)
  actionKey       String
  title           String   @default("")
  description     String   @default("")
  category        String   @default("")
  fixesMetrics    String[] @default([])
  recoveryTime    Int      @default(30)
  pointsIfCorrect Int      @default(50)
  pointsIfWrong   Int      @default(0)

  incident IncidentSimulation @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, actionKey])
  @@index([incidentId])
  @@map("incident_action_options")
}

model IncidentMetricSeries {
  id         String @id @default(cuid())
  incidentId String
  metricName String

  incident  IncidentSimulation       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  snapshots IncidentMetricSnapshot[]

  @@unique([incidentId, metricName])
  @@index([incidentId])
  @@map("incident_metric_series")
}

model IncidentMetricSnapshot {
  id        String @id @default(cuid())
  seriesId  String
  timestamp Int    @default(0)
  value     Float  @default(0)

  series IncidentMetricSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, timestamp])
  @@map("incident_metric_snapshots")
}

model IncidentSession {
  id                  String    @id @default(cuid())
  userId              String
  incidentId          String
  elapsedTime         Int       @default(0)
  isActive            Boolean   @default(true)
  isCompleted         Boolean   @default(false)
  xpAwarded           Boolean   @default(false)
  attempts            Int       @default(0)
  selectedRootCauseId String    @default("")
  diagnosedAt         DateTime?
  correctDiagnosis    Boolean   @default(false)
  diagnosticScore     Int       @default(0)
  actionScore         Int       @default(0)
  timeBonusScore      Int       @default(0)
  totalScore          Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident IncidentSimulation   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  state    IncidentSessionState?
  actions  IncidentSessionAction[]

  @@index([userId, incidentId])
  @@map("incidentsessions")
}

model IncidentSessionAction {
  id        String  @id @default(cuid())
  sessionId String
  actionKey String
  timestamp Int     @default(0)
  effective Boolean @default(false)

  session IncidentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("incident_session_actions")
}

model IncidentSessionState {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  currentTime Int      @default(0)
  metrics     Json     @default("{}")
  logs        String[] @default([])
  activeAlerts String[] @default([])
  updatedAt   DateTime @updatedAt

  session  IncidentSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  services IncidentSessionService[]

  @@map("incidentsessionstates")
}

model IncidentSessionService {
  id             String @id @default(cuid())
  sessionStateId String
  sortOrder      Int    @default(0)
  serviceKey     String
  name           String @default("")
  status         String @default("healthy")
  color          String @default("green")

  sessionState IncidentSessionState @relation(fields: [sessionStateId], references: [id], onDelete: Cascade)

  @@unique([sessionStateId, serviceKey])
  @@index([sessionStateId])
  @@map("incident_session_services")
}

// ─── Page maintenance ───────────────────────────────────────────────────────

model MaintenancePage {
  id        String   @id @default(cuid())
  path      String   @unique
  message   String   @default("This page is currently under maintenance. Please check back later.")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("maintenancepages")
}

// ─── Platform settings ───────────────────────────────────────────────────────

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String   @default("")
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("platformsettings")
}

// ─── Premium billing ─────────────────────────────────────────────────────────

model PremiumProduct {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String   @default("")
  kind          String   @default("track")
  trackKey      String   @default("")
  active        Boolean  @default(true)
  priceInrPaise Int      @default(0)
  priceUsdCents Int      @default(0)
  freeItemQuota Int      @default(0)
  displayOrder  Int      @default(0)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entitlements UserEntitlement[]
  orders       PaymentOrder[]

  @@index([active, displayOrder])
  @@index([kind])
  @@index([trackKey])
  @@map("premiumproducts")
}

model UserEntitlement {
  id             String    @id @default(cuid())
  userId         String
  productId      String?
  scope          String    @default("track")
  trackKey       String    @default("")
  source         String    @default("purchase")
  active         Boolean   @default(true)
  startsAt       DateTime  @default(now())
  expiresAt      DateTime?
  paymentOrderId String?
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      PremiumProduct? @relation(fields: [productId], references: [id])
  paymentOrder PaymentOrder?   @relation(fields: [paymentOrderId], references: [id])

  @@unique([userId, scope, trackKey])
  @@index([userId, active])
  @@index([trackKey, active])
  @@map("userentitlements")
}

model PaymentOrder {
  id                String    @id @default(cuid())
  userId            String
  productId         String
  razorpayOrderId   String    @unique
  razorpayPaymentId String    @default("")
  razorpaySignature String    @default("")
  receipt           String    @unique
  currency          String
  amount            Int
  status            String    @default("created")
  metadata          Json      @default("{}")
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      PremiumProduct    @relation(fields: [productId], references: [id])
  entitlements UserEntitlement[]
  events       PaymentEvent[]

  @@index([userId, status])
  @@index([productId])
  @@index([createdAt])
  @@map("paymentorders")
}

model PaymentEvent {
  id             String   @id @default(cuid())
  userId         String?
  paymentOrderId String?
  provider       String   @default("razorpay")
  eventType      String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([paymentOrderId])
  @@map("paymentevents")
}

// ─── Announcements ───────────────────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("info")
  audience  String   @default("all")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("announcements")
}

// ─── Audit log ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  targetName String   @default("")
  detail     String   @default("")
  adminEmail String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("auditlogs")
}
