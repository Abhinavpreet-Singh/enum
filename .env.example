# ─── Backend API (required at build time for NEXT_PUBLIC_* inlining) ─────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# ─── Frontend URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EXAM_APP_URL=http://localhost:3000

# ─── Optional ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_ENDPOINT=

# ─── Runtime (Docker / Dokploy) ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
