.env*
!.env.example

# Local Postgres only. Production uses the Dokploy-managed DB via DATABASE_URL.
/backend/docker-compose.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tauri
/.tauri
/src-tauri/target/
/src-tauri/**/target/
/src-tauri/*.db
/src-tauri/*.sqlite
/src-tauri/*.lock
/target/
